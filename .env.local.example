# ==============================================================================
# SECURE EMAIL VERIFICATION (6-DIGIT OTP) CONFIGURATION
# ==============================================================================

# --- 1. Resend API Configuration (Primary Transactional Provider) ---
# Sign up at https://resend.com and generate an API Key.
# Never expose this key with NEXT_PUBLIC_ prefix!
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Verified sender address or domain on Resend (e.g. "Thoughts App <onboarding@resend.dev>" or "support@yourdomain.com")
EMAIL_FROM=onboarding@resend.dev

# --- 2. Cryptographic OTP Hashing Secret ---
# Secret key used for HMAC-SHA256 hashing. If omitted, the server will derive a secure secret.
OTP_SECRET=change-this-to-a-very-long-and-cryptographically-random-secret-key-32-chars

# --- 3. Firebase Client SDK (Web App Settings from Firebase Console) ---
# Project Settings -> General -> Your apps -> Web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# --- 4. Alternative/Fallback Email Providers (Optional) ---
# If Resend is not configured, you can use direct Gmail SMTP or Brevo:
# GMAIL_USER=youraccount@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_google_app_password
# BREVO_API_KEY=xkeysib-...

# --- 5. Thoughts AI Configuration (Optional) ---
# The app includes a smart built-in Thoughts AI engine that works without any keys.
# To connect directly to live Google Gemini 1.5 Flash or OpenAI:
# GEMINI_API_KEY=AIzaSy... (Get free at https://aistudio.google.com)
# OPENAI_API_KEY=sk-...

